#!/usr/bin/env python3
"""close-tabs [other|right]

Close tabs in the current workspace: all except the focused tab (other)
or the tabs to its right (right).
"""
import json
import os
import subprocess
import sys


def detect_language() -> str:
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if value:
            return "ja" if value.lower().startswith("ja") else "en"
    return "en"


LANG = detect_language()

MESSAGES = {
    "usage": {"en": "usage: close-tabs [other|right] (got: {mode})",
              "ja": "使い方: close-tabs [other|right] (指定値: {mode})"},
    "no_base_tab": {"en": "cannot find a base tab", "ja": "基準となるタブが見つかりません"},
    "closed": {"en": "closed {ok}/{total} tabs", "ja": "{total} 個中 {ok} 個のタブを閉じました"},
}


def t(msg_id: str, **kwargs) -> str:
    text = MESSAGES[msg_id].get(LANG) or MESSAGES[msg_id]["en"]
    return text.format(**kwargs) if kwargs else text


mode = sys.argv[1] if len(sys.argv) > 1 else "other"
if mode not in ("other", "right"):
    sys.exit(t("usage", mode=mode))

bin_ = os.environ.get("HERDR_BIN_PATH", "herdr")
out = subprocess.run([bin_, "tab", "list"], capture_output=True, text=True, check=True).stdout
tabs = json.loads(out)["result"]["tabs"]

# When invoked as an action, herdr injects the target tab via HERDR_TAB_ID.
# Fall back to the focused tab otherwise.
base_tab_id = os.environ.get("HERDR_TAB_ID")
focused = next((t_ for t_ in tabs if t_["tab_id"] == base_tab_id), None) if base_tab_id \
    else next((t_ for t_ in tabs if t_.get("focused")), None)
if focused is None:
    sys.exit(t("no_base_tab"))

ws_tabs = [t_ for t_ in tabs if t_["workspace_id"] == focused["workspace_id"]]
idx = ws_tabs.index(focused)
targets = [t_ for i, t_ in enumerate(ws_tabs) if (i != idx if mode == "other" else i > idx)]

failed = 0
for t_ in targets:
    r = subprocess.run([bin_, "tab", "close", t_["tab_id"]], capture_output=True, text=True)
    if r.returncode != 0:
        failed += 1
print(t("closed", ok=len(targets) - failed, total=len(targets)))
sys.exit(1 if failed else 0)
